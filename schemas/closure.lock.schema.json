{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Gefferson-Souza/Tyrus/schemas/closure.lock.schema.json",
  "title": "closure.lock",
  "description": "Fecho de produção: arquivos regulares em ordem estrita por bytes do caminho, modo normalizado (0644 ou 0755) e sha256. Tipos Rust em crates/tyrus_facts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "files"],
  "properties": {
    "schema_version": { "const": 1 },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "mode", "sha256"],
        "properties": {
          "path": { "$ref": "#/$defs/relativePath" },
          "mode": { "enum": ["0644", "0755"] },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "relativePath": { "type": "string", "pattern": "^(\\.|[^/\\\\\\u0000]+(/[^/\\\\\\u0000]+)*)$", "not": { "pattern": "(^|/)\\.\\.?(/|$)" } }
  }
}
