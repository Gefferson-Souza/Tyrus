{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Gefferson-Souza/Tyrus/schemas/closure-archive.schema.json",
  "title": "closure-archive inspect",
  "description": "Saída de `tyrus-archive inspect --json`: descreve o arquivo do fecho depois de validar todos os hashes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "entry_count", "set_sha256", "compression", "total_size", "total_compressed_size", "entries"],
  "properties": {
    "format_version": { "const": 1 },
    "entry_count": { "type": "integer", "minimum": 0 },
    "set_sha256": { "$ref": "#/$defs/sha256" },
    "compression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codec", "level"],
      "properties": {
        "codec": { "const": "zstd" },
        "level": { "const": 3 }
      }
    },
    "total_size": { "type": "integer", "minimum": 0 },
    "total_compressed_size": { "type": "integer", "minimum": 0 },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "mode", "size", "compressed_size", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "mode": { "enum": [420, 493] },
        "size": { "type": "integer", "minimum": 0 },
        "compressed_size": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
