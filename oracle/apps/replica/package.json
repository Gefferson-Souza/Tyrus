{
  "name": "tyrus-replica-app",
  "version": "1.0.0",
  "private": true,
  "description": "Réplica de desenvolvimento do Tyrus: Nest 10.4 + TypeORM 0.3 + pg + throttler + class-validator",
  "engines": { "node": "26.11.1" },
  "scripts": {
    "build:emit": "tsc -p tsconfig.json",
    "build:bundle": "webpack --config webpack.config.js",
    "build": "npm run build:emit && npm run build:bundle"
  },
  "dependencies": {
    "@nestjs/common": "10.4.22",
    "@nestjs/core": "10.4.22",
    "@nestjs/platform-express": "10.4.22",
    "@nestjs/platform-fastify": "10.4.22",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/typeorm": "10.0.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.31"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "22.10.10",
    "@types/pg": "8.15.5",
    "ts-loader": "9.6.2",
    "typescript": "5.1.6",
    "webpack": "5.112.0",
    "webpack-cli": "7.2.3"
  }
}
